# Plantilla de credenciales necesarias para este workflow de n8n.
# NUNCA subas un archivo .env real con valores reales al repositorio.
# Estas credenciales se configuran directamente en el panel de n8n
# (Credentials), no como variables de entorno del propio workflow,
# pero se documentan aquí como referencia para nuevos colaboradores.

# --- Microsoft Outlook (lectura y envío de correo) ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_MAILBOX=daniel.estudio.alura.2026@outlook.com

# --- Cohere (modelo de lenguaje) ---
COHERE_API_KEY=

# --- Google Sheets ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_DOCUMENT_ID=
GOOGLE_SHEETS_SHEET_NAME=Pedidos
